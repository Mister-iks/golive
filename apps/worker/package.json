{
  "name": "@golive/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Background worker for PcyBox GoLive: runs audits from the queue and applies database migrations.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsup",
    "start": "node dist/worker.js",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@golive/db": "workspace:*",
    "@golive/engine": "workspace:*",
    "@golive/packs-sdk": "workspace:*",
    "@golive/probe": "workspace:*",
    "@golive/robot": "workspace:*",
    "@golive/spec": "workspace:*",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.14.0",
    "lighthouse": "13.6.0",
    "playwright-core": "1.65.1"
  }
}
