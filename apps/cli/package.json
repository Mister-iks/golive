{
  "name": "@pcybox/golive",
  "version": "0.2.0",
  "description": "PcyBox GoLive: verify a golive.yaml, scan a repository and audit a site, then gate your CI on the Go / No-Go verdict.",
  "license": "AGPL-3.0-only",
  "author": "PcyBox",
  "homepage": "https://github.com/Mister-iks/golive#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mister-iks/golive.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/Mister-iks/golive/issues"
  },
  "keywords": [
    "go-live",
    "production-readiness",
    "compliance",
    "security",
    "gdpr",
    "owasp",
    "wcag",
    "ci",
    "audit"
  ],
  "type": "module",
  "bin": {
    "golive": "dist/golive.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "commander": "^14.0.3",
    "picocolors": "^1.1.1",
    "@golive/engine": "workspace:*",
    "@golive/packs": "workspace:*",
    "@golive/packs-sdk": "workspace:*",
    "@golive/probe": "workspace:*",
    "@golive/scanner": "workspace:*",
    "@golive/spec": "workspace:*",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
