{
  "name": "@golive/cli",
  "version": "0.1.0",
  "description": "PcyBox GoLive command line: verify a golive.yaml and gate your CI on the Go / No-Go verdict.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": { "golive": "./dist/golive.js" },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "commander": "^14.0.3",
    "picocolors": "^1.1.1",
    "@golive/engine": "workspace:*",
    "@golive/packs": "workspace:*",
    "@golive/packs-sdk": "workspace:*",
    "@golive/probe": "workspace:*",
    "@golive/spec": "workspace:*",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  }
}
