# Copy to .env and adjust. docker compose reads the same variables.

# PostgreSQL connection used by the web app and the worker.
DATABASE_URL=postgres://golive:golive@localhost:5432/golive

# Secret used to sign sessions. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of the application (links in e-mails, cookie origin).
GOLIVE_URL=http://localhost:3000

# Outgoing e-mail (invitations, magic links, password reset).
# Without it, e-mails are printed in the server log and invitation links can be copied from the UI.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="PcyBox GoLive <golive@example.com>"

# Audit robot
# GOLIVE_MAX_PAGES=20                    pages visited by a full audit
# GOLIVE_AUDIT_BUDGET_SECONDS=150        time budget of a full audit
# GOLIVE_WORKER_CONCURRENCY=2            audits run in parallel by one worker
# GOLIVE_ALLOW_PRIVATE=0                 1 lets the robot reach private addresses (internal pre-production only)
# GOLIVE_SKIP_DOMAIN_VERIFICATION=0      1 allows full audits without domain ownership proof (single-tenant installs only)
# GOLIVE_BROWSER_CHANNEL=                chrome or msedge to use an installed browser instead of the bundled Chromium
# GOLIVE_LIGHTHOUSE=1                    0 skips the Lighthouse run of full audits (about 20 s each)

# Two-factor authentication is mandatory for organization owners and administrators
# before they invite, change roles or sign waivers. 0 disables the rule (single-person installs only).
# GOLIVE_REQUIRE_MFA=1
