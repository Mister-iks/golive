{
  "name": "golive",
  "private": true,
  "description": "PcyBox GoLive Community: the open-source go/no-go gate before any production launch.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.0.8",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "turbo run dev --filter=@golive/web --filter=@golive/worker",
    "db:migrate": "pnpm --filter @golive/worker exec tsx --env-file=../../.env src/main.ts --migrate-only",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "golive": "node apps/cli/dist/golive.js"
  },
  "devDependencies": {
    "turbo": "^2.11.13",
    "typescript": "~5.9.3",
    "@types/node": "^26.6.6"
  }
}
